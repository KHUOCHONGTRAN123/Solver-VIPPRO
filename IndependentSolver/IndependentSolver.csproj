<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>latest</LangVersion><Nullable>disable</Nullable>
    <Version>2.0.0</Version><PackageId>CatDom.Solver</PackageId><Description>Cat level solver with a 10,000-state baseline budget and improved-search fallback for Unity and .NET.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>1591;0649;0169</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Newtonsoft.Json" Version="13.0.3" /><EmbeddedResource Include="IO/HoleShapes.json" /></ItemGroup>
  <ItemGroup><None Include="../docs/API.md" Pack="true" PackagePath="README.md" /></ItemGroup>
</Project>
